# ===================================
# HYDEMEDIA ENVIRONMENT CONFIGURATION
# ===================================

# ----------------------
# Site Configuration
# ----------------------
NEXT_PUBLIC_SITE_URL=https://www.hydemedia.ch

# ----------------------
# Email Configuration (SMTP)
# ----------------------
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@hydemedia.ch
SMTP_PASS=your-app-password-here
SMTP_FROM="Hyde Media <hello@hydemedia.ch>"
CONTACT_EMAIL=theodor.staal@hydemedia.ch

# Alternative: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# ----------------------
# Analytics (Optional)
# ----------------------
# Vercel Analytics - Enabled by default when deployed to Vercel
# No configuration needed!

# Google Analytics (if you prefer GA4)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics (privacy-friendly alternative)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hydemedia.ch

# ----------------------
# Search Console Verification (Optional)
# ----------------------
# Add these to app/layout.tsx metadata.verification
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-verification-code
# NEXT_PUBLIC_BING_VERIFICATION=your-verification-code

# ----------------------
# Newsletter Integration (Optional)
# ----------------------
# Brevo (Recommended - FREE tier: 300 emails/day)
# Sign up: https://www.brevo.com
# BREVO_API_KEY=xkeysib-your-api-key-here
# BREVO_LIST_ID=1

# Mailchimp
# MAILCHIMP_API_KEY=your-api-key
# MAILCHIMP_LIST_ID=your-list-id

# ConvertKit
CONVERTKIT_API_KEY=your-api-key
CONVERTKIT_FORM_ID=your-form-id

# ----------------------
# Social Media (Optional)
# ----------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/hyde.med
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/hydemedia
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/hydemedia

# ----------------------
# Development
# ----------------------
# NODE_ENV=development
# PORT=3000
